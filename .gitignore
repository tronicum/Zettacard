__pycache__/
*.pyc
.DS_Store
.netlify/
node_modules/
# Local dev-only private signing key material - NEVER commit real key
# material. See docs/open-badges-signing-setup.md for how this is provided
# (a Netlify env var in production; a local .env.local for dev testing only).
.env
.env.local
*.pem
# Scratch git-bundle handoff files (sandbox -> user's disk, since this
# session can't push directly to GitHub) - never repo content, always
# delivered via SendUserFile/device bridge and then deleted here.
*.bundle

# API tokens kept as loose files in the repo root. .token_resend was caught by
# GitHub push protection on 2026-09-07 - it had been sitting in the working
# tree, untracked by .gitignore, alongside .env/.env.local/*.pem which WERE
# covered. Pattern rather than the one filename, so the next one is covered
# before it is written.
.token_*
*.token
