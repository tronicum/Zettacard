topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"2 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-01"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Woran müssen sich Fahrgäste nach § 14 Abs. 1 BOKraft grundsätzlich halten, wenn sie einen Linienbus benutzen?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-02"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Welches der folgenden Verhaltensweisen ist Fahrgästen nach § 14 Abs. 2 BOKraft ausdrücklich untersagt?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-03"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Darf ein Fahrgast versuchen, in einen als 'besetzt' gekennzeichneten Bus einzusteigen oder noch einzusteigen bzw. auszusteigen, wenn die Türen bereits schließen oder die Abfahrt unmittelbar bevorsteht?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-04"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was verlangt § 14 Abs. 3 BOKraft von Fahrgästen im Linienverkehr zusätzlich, etwa beim Ein- und Aussteigen?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-05"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was darf das Unternehmen bzw. das Fahr- oder Betriebspersonal tun, wenn ein Fahrgast trotz Ermahnung wiederholt gegen die Verhaltenspflichten des § 14 BOKraft verstößt?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-06"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was besagt die Beförderungspflicht nach § 22 PBefG für ein genehmigtes Busunternehmen?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"4 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-07"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Welche Pflicht ergibt sich aus der EU-Fahrgastrechteverordnung (VO (EU) Nr. 181/2011) gegenüber Personen mit Behinderungen oder eingeschränkter Mobilität im Busverkehr?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-08"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was sieht die EU-Fahrgastrechteverordnung vor, wenn ein Rollstuhl oder ein anderes Mobilitätshilfsmittel bei der Beförderung durch das Busunternehmen beschädigt wird?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"4 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-09"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Ein Fahrgast weigert sich, den Fahrpreis zu zahlen, und es kommt zu einer lauten Auseinandersetzung mit anderen Fahrgästen. Wie sollte sich der Busfahrer im Sinne der Sicherheit primär verhalten?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-10"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was gilt nach § 14 Abs. 2 BOKraft für den Umgang der Fahrgäste mit Sicherheitseinrichtungen im Bus, etwa Notausstiegsfenstern oder Nothämmern?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"2 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-11"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Dürfen Fahrgäste nach BOKraft grundsätzlich beliebig große und schwere Gegenstände (z. B. sperrige Fahrräder oder große Kisten) im Fahrgastraum mitführen?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"PBefG/BOKraft: Fahrgastverhalten und Sicherheit"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-pbefg-12"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Darf ein Fahrgast im Linienverkehr grundsätzlich von der Beförderung ausgeschlossen werden, wenn er offensichtlich erheblich alkoholisiert ist und andere Fahrgäste dadurch gefährdet oder erheblich belästigt?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"4 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-01"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Welche bus-spezifische Ausnahme von den Lenk- und Ruhezeitvorschriften der EU-VO 561/2006 sieht Art. 3 Buchst. a der Verordnung vor?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-02"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Ein Busfahrer fährt ausschließlich Linienverkehr innerhalb einer Stadt mit einer Linienlänge von 22 km. Gilt für ihn die EU-VO 561/2006 mit Fahrtenschreiberpflicht?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"4 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-03"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"§ 18 FPersV enthält nationale deutsche Ausnahmen von der EU-VO 561/2006 und VO (EU) 165/2014. Welche der folgenden Aussagen zu einer dort genannten personenverkehrsbezogenen Ausnahme trifft zu?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        ",["SPAN",{"class":"badge high-stakes"},"Sicherheitsrelevante Frage"],"\n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-04"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Ein Reisebusfahrer im grenzüberschreitenden Fernlinienverkehr (kein Ausnahmefall) unterliegt der EU-VO 561/2006. Wie lange darf die tägliche Lenkzeit höchstens sein, und wie oft pro Woche darf sie ausnahmsweise verlängert werden?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-05"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Nach spätestens 4,5 Stunden Lenkzeit muss ein Busfahrer im Fernlinien- oder Reiseverkehr (ohne Ausnahme) eine Fahrtunterbrechung einlegen. Wie lange muss diese mindestens sein, wenn sie nicht aufgeteilt wird?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-06"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Was gilt für die regelmäßige tägliche Ruhezeit eines Busfahrers im nicht ausgenommenen Reiseverkehr grundsätzlich?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"4 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-07"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Welche bus-spezifische Sonderregel enthält die EU-VO 561/2006 für die wöchentliche Ruhezeit bei einer einzelnen internationalen Fahrt im gelegentlichen Personenverkehr (z. B. mehrtägige Reisebus-Rundreise)?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-card-top"},"\n        ",["SPAN",{"class":"badge topic"},"Lenk- und Ruhezeiten sowie Fahrtenschreiber im Busverkehr"],"\n        ",["SPAN",{"class":"badge points"},"3 Punkte"],"\n        \n        \n        \n        ",["SPAN",{"class":"q-card-id"},"bus-lenkzeiten-08"],"\n      "],"\n      ",["DIV",{"class":"q-card-text"},"Muss ein Bus, der ausschließlich im Linienverkehr mit einer Streckenlänge von unter 50 km eingesetzt wird, mit einem Fahrtenschreiber gemäß VO (EU) Nr. 165/2014 ausgestattet und dieser genutzt werden?"],"\n    "],["DIV",{"class":"q-card","tabindex":"0","role":"button"},"\n      ",["DIV",{"class":"q-